# /opt/telemetron/fluentbit/fluent-bit.conf
# {{ ansible_managed }}
# Fluent Bit 4.2.3 -- Telemetron-tuned.
# Pitfall 6 mitigation pack inline-cited; D-50 buffer/timezone discipline.
# Role inversion (D-46) vs upstream: see roles/fluentbit/README.md
# "Deviations from upstream" section.

[SERVICE]
    Parsers_File              parsers.conf
    Log_Level                 info
    Flush                     {{ fluentbit_flush_interval }}
    HTTP_Server               On
    HTTP_Listen               0.0.0.0
    HTTP_Port                 {{ fluentbit_http_port }}
    Health_Check              On
    HC_Error_Count            5
    HTTP_Metrics              On
    # D-50: filesystem buffer survives container restart without log loss.
    storage.path              /var/log/flb-storage/
    storage.sync              normal
    storage.checksum          off
    storage.backlog.mem_limit {{ fluentbit_storage_backlog_mem_limit }}
    storage.max_chunks_up     {{ fluentbit_storage_max_chunks_up }}
    # Pitfall 6 (Mode 1: DST drift) -- UTC everywhere; never DST-observing TZ.
    # Default: Etc/UTC.
    Time_System_Timezone      {{ fluentbit_system_timezone }}
    # Pitfall 6 (Mode 3: multiline parser stuck timestamp) -- fail-fast bound.
    Multiline_Flush           {{ fluentbit_multiline_flush }}

# D-46: Docker container logs default tail.
# ROLE INVERSION vs upstream -- single-host colocated FB-with-workloads;
# see roles/fluentbit/README.md "Deviations from upstream" section.
# Default tail path resolves to: /var/lib/docker/containers/*/*-json.log
[INPUT]
    Name              tail
    Alias             docker_containers
    Path              {{ fluentbit_docker_logs_path }}/*/*-json.log
    Parser            docker
    Tag               docker.<container_id>
    Tag_Regex         (?<container_id>[^/]+)\.log$
    Refresh_Interval  5
    Read_from_Head    false
    Mem_Buf_Limit     10MB
    Skip_Long_Lines   On
    storage.type      filesystem
    Buffer_Max_Size   1MB
    Buffer_Chunk_Size 32KB

{% if enable_nfsd | default(false) | bool %}
# D-92 + D-95: opt-in NFS path tail. Fires when enable_nfsd is true in
# inventory (default false). Path tails `<share-root>/<hostname>/*.log` per
# the share-root sub-dir-per-host convention (see roles/nfsd/README.md
# "How this integrates with Fluent Bit"). Tag asterisk expansion produces
# `nfs.srv.telemetron-nfs.<hostname>.<filename...>` -- the sibling
# [FILTER] lua Match nfs.* below extracts the hostname from segment 4.
[INPUT]
    Name              tail
    Alias             nfs_logs
    Path              {{ nfsd_share_root | default('/srv/telemetron-nfs') }}/*/*.log
    Tag               nfs.*
    Refresh_Interval  10
    Read_from_Head    false
    Skip_Long_Lines   On
    Mem_Buf_Limit     5MB
    storage.type      filesystem
    DB                /var/log/flb-nfs.db
{% endif %}

# D-48: extension knobs (default-off).
{% if fluentbit_tail_system_logs | default(false) %}
[INPUT]
    Name              tail
    Alias             system_logs
    Path              /var/log/syslog,/var/log/auth.log,/var/log/kern.log,/var/log/messages
    Tag               system.*
    Refresh_Interval  10
    Read_from_Head    false
    Skip_Long_Lines   On
    storage.type      filesystem
{% endif %}

{% if fluentbit_tail_journald | default(false) %}
[INPUT]
    Name              systemd
    Alias             journald
    Path              /run/log/journal
    Tag               journald.*
    Read_From_Tail    on
    Strip_Underscores on
{% endif %}

{% for entry in fluentbit_extra_tail_paths | default([]) | sort %}
[INPUT]
    Name              tail
    Alias             extra_{{ loop.index }}
    Path              {{ entry }}
    Tag               extra.{{ loop.index }}.*
    Refresh_Interval  10
    Read_from_Head    false
    storage.type      filesystem
{% endfor %}

# Plan 03-05: INGEST-07 service + job label enrichment.
# Reads /var/lib/docker/containers/<id>/config.v2.json (RO bind-mount;
# already mounted by tasks/main.yml -- sibling of *-json.log). Extracts
# org.telemetron.{service,job} Docker labels with container-name + 'unlabeled'
# fallbacks. NO Docker socket access. Cache TTL 300s (see enrich.lua).
[FILTER]
    Name              lua
    Alias             telemetron_enrich
    Match             docker.*
    script            {{ fluentbit_enrich_lua_path }}
    call              enrich

{% if enable_nfsd | default(false) | bool %}
# D-95: NFS path branch -- sibling [FILTER] lua with Match nfs.*. Calls
# the SAME enrich() function in the SAME enrich.lua file (single source of
# truth for label enrichment). Pitfall 4 (RESEARCH Common Pitfalls): this
# block MUST use `Match nfs.*` -- NEVER `Match *` -- because the same
# enrich.lua handles Docker container logs via the Match docker.* filter
# above; cross-matching corrupts host labels on Docker records.
[FILTER]
    Name              lua
    Alias             telemetron_enrich_nfs
    Match             nfs.*
    script            {{ fluentbit_enrich_lua_path }}
    call              enrich
{% endif %}

# D-47 label allowlist: static deploy-time labels.
[FILTER]
    Name              modify
    Alias             allowlist_static
    Match             docker.*
    Add               host {{ ansible_hostname }}
    Add               env {{ telemetron_env | default('homelab') }}

# D-47 level extraction via regex parser. Fallback default when no match.
[FILTER]
    Name              parser
    Alias             extract_level
    Match             docker.*
    Key_Name          log
    Parser            level_extractor
    Reserve_Data      On
    Preserve_Key      On

[FILTER]
    Name              modify
    Alias             default_level
    Match             docker.*
    Add               level {{ fluentbit_default_level }}

# Pitfall 6 (Mode 2: missing date in source line) -- fallback @timestamp.
# DISABLED: Fluent Bit 4.x rejects `Add @timestamp ${ingest_time}` as
# "Invalid operation add : @timestamp". Likely cause: `${ingest_time}` is
# not a defined env var so the substitution leaves the value empty, AND/OR
# keys beginning with `@` need quoting in FB 4. Docker logs already include
# their own timestamp so this fallback is for edge cases only. Re-enable
# with proper FB-4-compatible syntax in a follow-up. Caught Phase 3 UAT
# 2026-05-18 (03-UAT.md gap fluentbit-modify-add-at-timestamp-rejected).
#[FILTER]
#    Name              modify
#    Alias             timestamp_fallback
#    Match             *
#    Add               @timestamp ${ingest_time}

# D-49: ship to OTel Collector via OTLP/HTTP.
# Logs_uri default resolves to: /v1/logs (Loki OTLP receiver path on the
# OTel Collector side; see roles/opentelemetry/templates/config.yaml.j2).
[OUTPUT]
    Name              opentelemetry
    Alias             otel_logs
    Match             *
    Host              {{ fluentbit_otel_host }}
    Port              {{ fluentbit_otel_port }}
    Logs_uri          {{ fluentbit_otel_logs_uri }}
    log_response_payload false
    Tls               Off
