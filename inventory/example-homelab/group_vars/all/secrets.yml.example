---
# Telemetron -- example secrets file
#
# USAGE:
#   1. Copy this file:
#        cp inventory/example-homelab/group_vars/all/secrets.yml.example \
#           inventory/example-homelab/group_vars/all/secrets.yml
#   2. Replace every CHANGE_ME with a strong random value (32+ chars).
#   3. Protect the file. Operator's choice: ansible-vault, sops, env-var
#      injection, an external secret manager, or chmod 600 on a homelab.
#      Telemetron does not impose a vaulting tool -- the contract is just
#      "these variable names must resolve to real values at playbook time."
#      The ansible-vault path (matches the old default):
#        ansible-vault encrypt inventory/example-homelab/group_vars/all/secrets.yml
#      Then supply the vault password via --ask-vault-pass,
#      --vault-password-file <path>, or ANSIBLE_VAULT_PASSWORD_FILE env var.
#
# NAMING CONVENTION: role-namespaced -- <role>_<purpose>. No `vault_` prefix
# (per D-90 / [[feedback-no-decorative-convention-prefixes]]); the role
# namespace + descriptive suffix carry the meaning. Each role's README
# "Secrets" section documents the keys it expects.
#
# GIT HYGIENE: this .example file IS committed (placeholders only).
# The real secrets.yml is in .gitignore -- DO NOT commit a populated file.

# --- Phase 8: Garage ---
# Consumed by: roles/garage (admin API token + cluster RPC secret)
# D-110: garage_admin_token maps to GARAGE_ADMIN_TOKEN env var on the container;
#   required for the admin API (:3903) and all /garage CLI commands. No vault_ prefix (D-90).
# D-112: S3 access key and secret (garage_s3_access_key_id / garage_s3_secret_key)
#   are NOT listed here -- they are auto-generated by the Garage bootstrap on first run
#   and persisted to a host file. Re-runs load from that file. Operators never supply them.
# garage_rpc_secret: generate with `openssl rand -hex 32`.
garage_admin_token: CHANGE_ME   # Garage admin API bearer token (arbitrary string, recommend 32+)
garage_rpc_secret: CHANGE_ME    # Garage cluster RPC secret (generate: openssl rand -hex 32)

# --- Phase 8: Loki S3 credentials (D-113) ---
# Consumed by: roles/loki (S3 access to the loki-chunks bucket).
# garage_s3_access_key_id and garage_s3_secret_key are set_fact'd by the
# Garage role bootstrap from the D-112 host file on each run. These aliases
# reference those dynamically loaded facts -- no CHANGE_ME value needed here.
loki_s3_access_key: "{{ garage_s3_access_key_id }}"
loki_s3_secret_key: "{{ garage_s3_secret_key }}"

# --- Phase 8: Tempo S3 credentials (D-113) ---
# Consumed by: roles/tempo (S3 access to the tempo-traces bucket).
# Values alias to garage_s3_* facts loaded by Garage bootstrap (D-113).
tempo_s3_access_key: "{{ garage_s3_access_key_id }}"
tempo_s3_secret_key: "{{ garage_s3_secret_key }}"

# --- Phase 8: Mimir S3 credentials (D-113) ---
# Consumed by: roles/mimir (S3 access to all three mimir-* buckets:
# mimir-blocks, mimir-ruler, mimir-alerts -- Mimir refuses to start
# sharing buckets across these stores, per BACK-04 / Pitfall G).
# Values alias to garage_s3_* facts loaded by Garage bootstrap (D-113).
mimir_s3_access_key: "{{ garage_s3_access_key_id }}"
mimir_s3_secret_key: "{{ garage_s3_secret_key }}"

# --- Phase 5: Grafana (D-86; UI-01) ---
# Consumed by: roles/grafana (GF_SECURITY_ADMIN_PASSWORD env injection on
# the telemetron-grafana container).
# IMPORTANT: this env var is FIRST-BOOT-ONLY (RESEARCH §2.1 Risk 2). On
# the initial deploy it sets the admin password in Grafana's SQLite store;
# subsequent restarts do NOT re-apply changes. To rotate the password
# after first deploy:
#   docker exec telemetron-grafana grafana-cli admin reset-admin-password '<new>'
# Then update this value to match so Gate 9 verify (which curls
# /api/datasources/uid/*/health with Basic Auth) keeps passing.
grafana_admin_password: CHANGE_ME

# --- Phase 2+ additional keys will be added here as their roles land ---
# Note: Phase 4 (alertmanager) adds NO secret keys (D-66). The null
# default receiver has no outbound destination; the single-host bridge
# trust boundary covers inbound. The previously-planned hook_router
# secret keys (jenkins_api_token, shared-secret) moved with the
# hook-router deferral to a future milestone -- see REQUIREMENTS.md
# ALERT-V2-01..05.
